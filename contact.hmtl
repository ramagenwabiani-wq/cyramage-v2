<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us | CyRamage</title>
    <link rel="stylesheet" href="css/style.css?v=9">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
</head>
<body>

  <div class="top-bar">
    <div class="top-bar-track">
        <span>🚚 Free UK Delivery on Orders Over £50</span>
        <span>🚚 Free UK Delivery on Orders Over £50</span>
    </div>
  </div>

  <header>
    <div class="navbar">
        <a href="index.html#home" class="logo">
            <img src="images/logo.png" alt="CyRamage Logo">
        </a>

        <button class="mobile-menu-button" id="mobileMenuButton" type="button" aria-label="Open navigation menu" aria-expanded="false">
            <span></span><span></span><span></span>
        </button>

        <nav id="mainNavigation">
            <a href="index.html#home">Home</a>
            <a href="index.html#shop">Shop</a>
            <a href="index.html#collections">Collections</a>
            <a href="about.html">About</a>
            <a href="contact.html">Contact</a>
        </nav>
    </div>
  </header>

  <section class="container" style="padding: 80px 20px; max-width: 700px; margin: 0 auto;">
    <h1 style="text-align:center;">Contact Us</h1>
    <p style="text-align:center; margin-bottom: 40px;">
        We'd love to hear from you. Reach out to the right team below and we'll get back to you as soon as possible.
    </p>

    <div style="display:grid; gap: 24px;">

        <div>
            <h3>General Enquiries</h3>
            <p><a href="mailto:hello@cyramage.com">hello@cyramage.com</a></p>
        </div>

        <div>
            <h3>Customer Service</h3>
            <p><a href="mailto:support@cyramage.com">support@cyramage.com</a></p>
        </div>

        <div>
            <h3>Order Enquiries</h3>
            <p><a href="mailto:orders@cyramage.com">orders@cyramage.com</a></p>
        </div>

        <div>
            <h3>Other</h3>
            <p><a href="mailto:contact@cyramage.com">contact@cyramage.com</a></p>
        </div>

    </div>
  </section>

  <footer class="footer">
    <div class="footer-container">
        <div class="footer-column">
            <img src="images/logo.png" alt="CyRamage Logo" class="footer-logo">
            <p>Luxury self-care, elegant gifts and lifestyle essentials designed to bring beauty to every moment.</p>
        </div>

        <div class="footer-column">
            <h3>Shop</h3>
            <a href="self-care.html">Self-Care</a>
            <a href="accessories.html">Accessories</a>
            <a href="home-fragrance.html">Home Fragrance</a>
            <a href="fashion.html">Women's Fashion</a>
            <a href="books.html">Books & Digital</a>
        </div>

        <div class="footer-column">
            <h3>Customer Care</h3>
            <a href="contact.html">Contact Us</a>
            <a href="delivery.html">Delivery</a>
            <a href="returns.html">Returns</a>
            <a href="faqs.html">FAQs</a>
        </div>

        <div class="footer-column">
            <h3>Follow Us</h3>
            <!-- TODO: add real Instagram URL once brand account is live -->
            <a href="#">Instagram</a>
            <!-- TODO: add real Facebook URL once brand account is live -->
            <a href="#">Facebook</a>
            <!-- TODO: add real Pinterest URL once brand account is live -->
            <a href="#">Pinterest</a>
            <!-- TODO: add real TikTok URL once brand account is live -->
            <a href="#">TikTok</a>
        </div>
    </div>

    <div class="footer-bottom">
        © 2026 CyRamage. All Rights Reserved.
    </div>
  </footer>

<script>
    const mobileMenuButton = document.getElementById("mobileMenuButton");
    const mainNavigation = document.getElementById("mainNavigation");
    if (mobileMenuButton && mainNavigation) {
        mobileMenuButton.addEventListener("click", function () {
            const isOpen = mainNavigation.classList.toggle("open");
            mobileMenuButton.setAttribute("aria-expanded", String(isOpen));
        });
        mainNavigation.querySelectorAll("a").forEach(function (link) {
            link.addEventListener("click", function () {
                mainNavigation.classList.remove("open");
                mobileMenuButton.setAttribute("aria-expanded", "false");
            });
        });
    }
</script>
</body>
</html>
